{
    "layer": "top",
    "position": "top",
    "spacing": 4,
    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "temperature",
        "hyprland/language",
        "battery",
        "clock"
    ],
    "include": ["~/.config/waybar/modules.json"]
}
