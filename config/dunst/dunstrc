[global]
    monitor = 0
    follow = none
    width = 360
    height = (0, 180)
    origin = top-right
    offset = (14, 42)
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 120
    progress_bar_max_width = 332
    progress_bar_corner_radius = 2

    indicate_hidden = true
    transparency = 0
    separator_height = 0
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 1
    frame_color = "#303236"
    gap_size = 8

    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    stack_duplicates = true
    hide_duplicate_count = true
    show_indicators = false

    icon_position = left
    min_icon_size = 24
    max_icon_size = 40
    icon_corner_radius = 4
    corner_radius = 8
    corners = all

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0e0f10"
    foreground = "#a0a0a0"
    timeout = 3

[urgency_normal]
    background = "#0e0f10"
    foreground = "#e0e0e0"
    timeout = 5

[urgency_critical]
    background = "#0e0f10"
    foreground = "#e0e0e0"
    frame_color = "#e1251b"
    timeout = 0
